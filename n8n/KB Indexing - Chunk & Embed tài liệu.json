    {
      "parameters": {
        "jsCode": "const docs = $('Supabase - Lấy tài liệu chưa index').all();;\nconst CHUNK_SIZE = 1500;\n\nconst result = [];\n\nfor (const item of docs) {\n  const doc = item.json;\n  const text = doc.content || '';\n\n  for (let i = 0, idx = 0; i < text.length; i += CHUNK_SIZE, idx++) {\n    result.push({\n      json: {\n        document_id: doc.id,\n        chunk_index: idx,\n        chunk_text: text.slice(i, i + CHUNK_SIZE),\n      }\n    });\n  }\n}\n\nreturn result;"
      },

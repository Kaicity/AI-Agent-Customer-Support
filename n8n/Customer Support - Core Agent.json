      "parameters": {
        "jsCode": "const chunks = $input.all();\n\nconst context = chunks\n  .map(item => item.json.chunk_text)\n  .filter(Boolean)\n  .join('\\n---\\n');\n\nreturn [{\n  json: {\n    context,\n    has_context: chunks.length > 0\n  }\n}];"
